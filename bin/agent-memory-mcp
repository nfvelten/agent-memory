#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Required: set AGENT_MEMORY_VAULT to your Obsidian vault path
export AGENT_MEMORY_VAULT="${AGENT_MEMORY_VAULT:-${HOME}/vault}"

# Optional: colon-separated list of memory roots (defaults to Pessoal + Trabalho inside vault)
export AGENT_MEMORY_ROOTS="${AGENT_MEMORY_ROOTS:-}"

# Optional: colon-separated list of code dirs to index CLAUDE.md files from
export AGENT_MEMORY_WORKS="${AGENT_MEMORY_WORKS:-}"

# Optional: index location (defaults to <vault>/.agent-memory/index)
export AGENT_MEMORY_INDEX="${AGENT_MEMORY_INDEX:-${AGENT_MEMORY_VAULT}/.agent-memory/index}"

exec python3 "${SCRIPT_DIR}/../mcp_server.py"
