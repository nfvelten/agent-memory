# Copy this file and adjust paths for your setup.
# Source it before running agent-memory commands:
#   source my.env && python agent_memory_indexer.py

# Path to your Obsidian vault (required)
export AGENT_MEMORY_VAULT=$HOME/vault

# Colon-separated list of memory root dirs inside the vault
# Defaults to <vault>/Pessoal/Memória de Agentes:<vault>/Trabalho/Memória de Agentes
# export AGENT_MEMORY_ROOTS=$HOME/vault/Memory

# Colon-separated list of code dirs to index CLAUDE.md/AGENTS.md files from
# export AGENT_MEMORY_WORKS=$HOME/code/work:$HOME/code/personal

# Where the SQLite + vector index is stored (default: <vault>/.agent-memory/index)
export AGENT_MEMORY_INDEX=$HOME/vault/.agent-memory/index
